from ./behaviors import
    Announcement,
    Disclosure,
    Dismissal,
    Dragging,
    Filtering,
    FormParticipation,
    KeyboardShortcuts,
    Modality,
    Positioning,
    Presence,
    Selection,
    Traversal,
    Virtualisation
from ./components import
    Accordion,
    AngleSlider,
    Avatar,
    Button,
    Carousel,
    CascadeSelect,
    Checkbox,
    Collapsible,
    ColorPicker,
    Combobox,
    ContextMenu,
    CopyButton,
    DateInput,
    DatePicker,
    Dialog,
    Drawer,
    DropZone,
    EditableText,
    FilePicker,
    FloatingActionButton,
    FloatingPanel,
    Grid,
    HoverCard,
    IconButton,
    ImageCropper,
    Link,
    List,
    Marquee,
    Menu,
    NavigationMenu,
    NumberInput,
    Pagination,
    PasswordInput,
    PinInput,
    Popover,
    Progress,
    QrCode,
    Radio,
    RadioGroup,
    Rating,
    ScrollArea,
    SegmentedControl,
    Select,
    SignaturePad,
    Slider,
    Splitter,
    Stepper,
    Steps,
    Switch,
    TableOfContents,
    Tabs,
    TagsInput,
    TextArea,
    TextField,
    TimePicker,
    Timer,
    Toast,
    ToggleButton,
    ToggleGroup,
    Tooltip,
    Tour,
    TreeView

export anchor UiCatalog:
    description:
        Every component and behaviour in ui-components. Components are grouped
        the way the spec is organised; behaviours are the shared rules that
        components list under their own behaviors. Start from the component
        that matches what the user needs, then follow its links.

    behaviors:
        - @{Announcement}
        - @{Disclosure}
        - @{Dismissal}
        - @{Dragging}
        - @{Filtering}
        - @{FormParticipation}
        - @{KeyboardShortcuts}
        - @{Modality}
        - @{Positioning}
        - @{Presence}
        - @{Selection}
        - @{Traversal}
        - @{Virtualisation}

    components:
        links:
            - @{Link}
        buttons:
            - @{Button}
            - @{CopyButton}
            - @{FloatingActionButton}
            - @{IconButton}
            - @{ToggleButton}
            - @{ToggleGroup}
        choices:
            - @{CascadeSelect}
            - @{Combobox}
            - @{RadioGroup}
            - @{SegmentedControl}
            - @{Select}
        collections:
            - @{List}
            - @{TreeView}
        disclosure:
            - @{Accordion}
            - @{Collapsible}
            - @{Tabs}
        feedback:
            - @{Progress}
            - @{Timer}
            - @{Toast}
        fields:
            - @{EditableText}
            - @{NumberInput}
            - @{PasswordInput}
            - @{PinInput}
            - @{TagsInput}
            - @{TextArea}
            - @{TextField}
        files:
            - @{DropZone}
            - @{FilePicker}
        layout:
            - @{Grid}
            - @{ScrollArea}
            - @{Splitter}
        media:
            - @{Avatar}
            - @{Carousel}
            - @{ImageCropper}
            - @{Marquee}
            - @{QrCode}
            - @{SignaturePad}
        navigation:
            - @{NavigationMenu}
            - @{Pagination}
            - @{Steps}
            - @{TableOfContents}
        overlays:
            - @{ContextMenu}
            - @{Dialog}
            - @{Drawer}
            - @{FloatingPanel}
            - @{HoverCard}
            - @{Menu}
            - @{Popover}
            - @{Tooltip}
            - @{Tour}
        pickers:
            - @{ColorPicker}
            - @{DateInput}
            - @{DatePicker}
            - @{TimePicker}
        ranges:
            - @{AngleSlider}
            - @{Rating}
            - @{Slider}
            - @{Stepper}
        toggles:
            - @{Checkbox}
            - @{Radio}
            - @{Switch}
