use /lib/UiComponent

from /components/buttons/Button import Button

export ui-component IconButton:
    description:
        An icon button is a button that shows only an icon, with no text. It
        still has a name describing what it does, and usually shows that name
        when the user hovers over it or focuses it.

    composes:
        - @{Button}

    content:
        One icon, and no visible text.

    name:
        A name is required. The icon on its own doesn't count as one.

    nameDisclosure:
        The name is shown when the user points at or focuses the button, such
        as in a tooltip. How it is shown is up to the chosen library.
