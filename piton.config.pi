use @piton/belay
use @piton/config
use @piton/packaging

from @piton/belay import ClaudeCodeAdapter

export piton-config Project:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {BelayConfiguration}

    packages:
        - {UiComponents}

belay-config BelayConfiguration:
    codeRoot: ./src

    adapters:
        - {ClaudeCodeAdapter}

piton-package UiComponents:
    root: ./spec
    name: ui-components
